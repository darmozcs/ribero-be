# Copiar a /opt/infra/services/ribero-be/.env en el servidor y completar.
# chmod 600 .env una vez completado (contiene secretos).

APP_IMAGE=ghcr.io/darmozcs/ribero-be:latest
APP_DOMAIN=darmozsc.duckdns.org
APP_PATH_PREFIX=/ribero-api
APP_PORT=8080

# Postgres compartido (contenedor "postgres", red "data") — misma base
# "nexora" que usa darmoz-auth. Las tablas propias de este servicio estan
# prefijadas rb_ (rb_users, rb_locales, rb_ventas, ..., rb_flyway_schema_history) para no
# colisionar con las auth_* de darmoz-auth.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexora
SPRING_DATASOURCE_USERNAME=nexora
SPRING_DATASOURCE_PASSWORD=nexora

# Solo hace falta la llave publica RSA de darmoz-auth (este servicio nunca
# firma tokens, solo los verifica). Montada desde ./keys (ver compose.yaml).
JWT_PUBLIC_KEY_PATH=/app/keys/public_key.pem
JWT_ISSUER=darmoz-auth

# UUID de la Application de darmoz-auth que este servicio acepta
# (aplicacion "ribero", creada por la migracion V9 de darmoz-auth).
APP_EXPECTED_APPLICATION_ID=33333333-3333-3333-3333-333333333333
